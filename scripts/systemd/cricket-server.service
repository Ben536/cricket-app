[Unit]
Description=CricketRadar - WebSocket Server
Documentation=file:///home/bdrysdale/cricket-app/designs/001-boot-automation.md

# Start after radar is configured (or after timeout). The server binds
# 0.0.0.0 and needs no particular interface up, so it does NOT wait for
# network-online.target - at the nets (no known WiFi) that wait blocks for the
# full NetworkManager-wait-online timeout (~30s) before the app can be used.
After=cricket-radar.service

# Weak dependency - start even if radar config failed
# This allows manual mode operation
Wants=cricket-radar.service

# Crash-loop rate limiting: at most 5 starts in 60s, then latch into `failed` and
# stop restarting (the health monitor clears that with `systemctl reset-failed`).
# These MUST live in [Unit]. In [Service] systemd logs "Unknown key name
# 'StartLimitIntervalSec' in section 'Service', ignoring" and falls back to
# DefaultStartLimitIntervalSec=10s - which RestartSec=3 can never trip (starts at
# t=0,3,6,9,12... is only 4 in any 10s window). The rate limit the comment below
# used to promise therefore did not exist, and a unit that cannot start restarted
# forever.
StartLimitIntervalSec=60
StartLimitBurst=5
StartLimitAction=none

[Service]
Type=simple

# Run as application user, not root
User=bdrysdale
Group=bdrysdale

# Working directory
WorkingDirectory=/home/bdrysdale/cricket-app

# Environment
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/bdrysdale/cricket-app

# Start the WebSocket server
ExecStart=/usr/bin/python3 -m server.websocket_server

# Automatic restart on failure
Restart=on-failure
RestartSec=3

# Graceful shutdown
TimeoutStopSec=10
KillMode=mixed
KillSignal=SIGTERM

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cricket-server

# Security hardening (non-essential but good practice)
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
# The `-` prefix makes a missing path non-fatal. Without it, a ReadWritePaths
# directory that does not exist fails the mount namespace and the unit dies with
# 226/NAMESPACE before Python runs at all - and `recordings/` is gitignored, so a
# fresh clone or reflashed card has no such directory. That is an unstartable
# server, which is exactly the condition the reboot gate now refuses to reboot on.
ReadWritePaths=-/home/bdrysdale/cricket-app/db
ReadWritePaths=-/home/bdrysdale/cricket-app/recordings

[Install]
WantedBy=multi-user.target

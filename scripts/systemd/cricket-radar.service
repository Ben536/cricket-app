[Unit]
Description=CricketRadar - Configure IWR6843 Radar
Documentation=file:///home/bdrysdale/cricket-app/designs/001-boot-automation.md

# The radar is a USB serial device; it needs no network. This unit used to
# pull network-online.target, which at the nets (no known WiFi) blocks for the
# full NetworkManager-wait-online timeout (~30s) on a boot the design budgets
# at 60s. configure_radar.py waits for the device node itself.
After=local-fs.target

# This service must complete before the WebSocket server starts
Before=cricket-server.service

[Service]
Type=oneshot
RemainAfterExit=yes

# Run as application user, not root
User=bdrysdale
Group=bdrysdale

# Working directory
WorkingDirectory=/home/bdrysdale/cricket-app

# The radar profile is the REPO copy, deployed with the code. A hand-edited
# ~/profile_cricket.cfg used to be the only copy and was never deployed;
# deploy_to_pi.sh warns if the two differ.
# --device-timeout: Wait up to 2 minutes for radar USB
# --max-retries: Try up to 5 times with backoff
ExecStart=/usr/bin/python3 /home/bdrysdale/cricket-app/scripts/configure_radar.py \
    /home/bdrysdale/cricket-app/config/profile_cricket.cfg \
    --device /dev/ttyUSB0 \
    --device-timeout 120 \
    --max-retries 5

# Give the script plenty of time to complete (device wait + retries)
TimeoutStartSec=300

# Restart handling - if config fails, try again after delay
Restart=on-failure
RestartSec=10

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cricket-radar

[Install]
WantedBy=multi-user.target

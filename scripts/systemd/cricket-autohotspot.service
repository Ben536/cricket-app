[Unit]
Description=CricketRadar - start AP if no known WiFi connects at boot
# '%' starts a specifier in a unit file, so the %20s of a URL-encoded path
# must be escaped as %%20 - otherwise systemd logs "Failed to resolve unit
# specifiers ... Invalid slot" and DROPS the whole line (seen on the Pi,
# 2026-09-06).
Documentation=file:///home/bdrysdale/cricket-app/vault/learnings/Pi%%20Deployment%%20and%%20Ops.md
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=oneshot
RemainAfterExit=yes
# root so nmcli can control connections without polkit prompts
User=root
ExecStart=/home/bdrysdale/cricket-app/scripts/autohotspot.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cricket-autohotspot

[Install]
WantedBy=multi-user.target

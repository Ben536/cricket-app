{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Cricket App WebSocket Protocol",
  "description": "Complete WebSocket message protocol for real-time communication between React UI and Python game engine on Raspberry Pi",
  "version": "1.1.0",
  "definitions": {
    "Position": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "description": "X coordinate in metres from batter"
        },
        "y": {
          "type": "number",
          "description": "Y coordinate in metres from batter (positive = toward bowler)"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false
    },
    "FielderConfig": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Optional unique fielder identifier - UI can generate for drag tracking, game engine doesn't require"
        },
        "x": {
          "type": "number",
          "description": "Screen X position (0-100%)"
        },
        "y": {
          "type": "number",
          "description": "Screen Y position (0-100%)"
        },
        "name": {
          "type": "string",
          "description": "Zone name e.g. 'cover', 'mid-off'"
        }
      },
      "required": [
        "x",
        "y",
        "name"
      ],
      "additionalProperties": false
    },
    "TrajectoryData": {
      "type": "object",
      "properties": {
        "projected_distance": {
          "type": "number",
          "description": "Total distance in metres (aerial + rolling)"
        },
        "aerial_distance": {
          "type": "number",
          "description": "Distance traveled through air"
        },
        "rolling_distance": {
          "type": "number",
          "description": "Distance ball rolls after landing"
        },
        "max_height": {
          "type": "number",
          "description": "Peak height in metres"
        },
        "landing_x": {
          "type": "number",
          "description": "X landing coordinate"
        },
        "landing_y": {
          "type": "number",
          "description": "Y landing coordinate"
        },
        "final_x": {
          "type": "number",
          "description": "X where ball stops"
        },
        "final_y": {
          "type": "number",
          "description": "Y where ball stops"
        },
        "time_of_flight": {
          "type": "number",
          "description": "Seconds in air"
        },
        "horizontal_speed": {
          "type": "number",
          "description": "m/s along ground"
        },
        "vertical_speed": {
          "type": "number",
          "description": "m/s initial vertical"
        },
        "direction_x": {
          "type": "number",
          "description": "Unit vector X component"
        },
        "direction_y": {
          "type": "number",
          "description": "Unit vector Y component"
        }
      },
      "required": [
        "projected_distance",
        "aerial_distance",
        "rolling_distance",
        "max_height",
        "landing_x",
        "landing_y",
        "final_x",
        "final_y",
        "time_of_flight",
        "horizontal_speed",
        "vertical_speed",
        "direction_x",
        "direction_y"
      ],
      "additionalProperties": false
    },
    "CatchAnalysis": {
      "type": "object",
      "description": "Wire format uses camelCase to match TypeScript conventions. Python snake_case properties are converted during JSON serialization.",
      "properties": {
        "canCatch": {
          "type": "boolean"
        },
        "difficulty": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "catchType": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "regulation",
            "hard",
            "spectacular",
            null
          ]
        },
        "reactionTime": {
          "type": "number"
        },
        "movementRequired": {
          "type": "number"
        },
        "movementPossible": {
          "type": "number"
        },
        "ballSpeedAtFielder": {
          "type": "number"
        },
        "heightAtIntercept": {
          "type": "number"
        },
        "timeToIntercept": {
          "type": "number"
        },
        "fielderArrivalTime": {
          "type": "number"
        },
        "arrivedBeforeLanding": {
          "type": "boolean"
        }
      },
      "required": [
        "canCatch",
        "difficulty",
        "catchType",
        "reactionTime",
        "movementRequired",
        "movementPossible",
        "ballSpeedAtFielder",
        "heightAtIntercept",
        "timeToIntercept",
        "fielderArrivalTime",
        "arrivedBeforeLanding"
      ],
      "additionalProperties": false
    },
    "ShotOutcome": {
      "type": "string",
      "enum": [
        "dot",
        "1",
        "2",
        "3",
        "4",
        "6",
        "caught",
        "dropped",
        "misfield"
      ]
    },
    "BallResult": {
      "type": "string",
      "enum": [
        "dot",
        "1",
        "2",
        "3",
        "4",
        "6",
        "W",
        "wd",
        "nb"
      ]
    },
    "Difficulty": {
      "type": "string",
      "enum": [
        "easy",
        "medium",
        "hard"
      ]
    },
    "BattingHand": {
      "type": "string",
      "enum": [
        "right",
        "left"
      ]
    },
    "ConnectionState": {
      "type": "string",
      "enum": [
        "disconnected",
        "connecting",
        "connected",
        "reconnecting"
      ]
    },
    "SessionState": {
      "type": "string",
      "enum": [
        "none",
        "active",
        "ended"
      ]
    },
    "Over": {
      "type": "object",
      "properties": {
        "balls": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/BallResult"
          }
        },
        "runs": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "balls",
        "runs"
      ],
      "additionalProperties": false
    },
    "SessionData": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "player_id": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "format": "date-time"
        },
        "runs": {
          "type": "integer",
          "minimum": 0
        },
        "balls": {
          "type": "integer",
          "minimum": 0
        },
        "fours": {
          "type": "integer",
          "minimum": 0
        },
        "sixes": {
          "type": "integer",
          "minimum": 0
        },
        "wickets": {
          "type": "integer",
          "minimum": 0
        },
        "is_out": {
          "type": "boolean"
        },
        "overs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Over"
          }
        },
        "strike_rate": {
          "type": "number",
          "minimum": 0
        },
        "field_config": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FielderConfig"
          },
          "description": "Sessions always have a field config"
        }
      },
      "required": [
        "id",
        "player_id",
        "date",
        "runs",
        "balls",
        "fours",
        "sixes",
        "wickets",
        "is_out",
        "overs",
        "strike_rate",
        "field_config"
      ],
      "additionalProperties": false
    },
    "Profile": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "batting_hand": {
          "$ref": "#/definitions/BattingHand"
        }
      },
      "required": [
        "id",
        "name",
        "batting_hand"
      ],
      "additionalProperties": false
    },
    "SimulationResult": {
      "type": "object",
      "description": "Full simulation result stored in database. Use REST API GET /api/sessions/:id/deliveries for detailed data.",
      "properties": {
        "outcome": {
          "$ref": "#/definitions/ShotOutcome"
        },
        "runs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "is_boundary": {
          "type": "boolean"
        },
        "is_aerial": {
          "type": "boolean"
        },
        "fielder_involved": {
          "type": [
            "string",
            "null"
          ]
        },
        "fielder_position": {
          "oneOf": [
            {
              "$ref": "#/definitions/Position"
            },
            {
              "type": "null"
            }
          ]
        },
        "fielding_position": {
          "oneOf": [
            {
              "$ref": "#/definitions/Position"
            },
            {
              "type": "null"
            }
          ]
        },
        "end_position": {
          "$ref": "#/definitions/Position"
        },
        "description": {
          "type": "string"
        },
        "trajectory": {
          "oneOf": [
            {
              "$ref": "#/definitions/TrajectoryData"
            },
            {
              "type": "null"
            }
          ]
        },
        "catch_analysis": {
          "oneOf": [
            {
              "$ref": "#/definitions/CatchAnalysis"
            },
            {
              "type": "null"
            }
          ]
        },
        "fielding_time": {
          "type": [
            "number",
            "null"
          ]
        },
        "collection_difficulty": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "alignment_score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "priority_score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "fielder_arrival_time": {
          "type": [
            "number",
            "null"
          ]
        },
        "ball_arrival_time": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "outcome",
        "runs",
        "is_boundary",
        "is_aerial",
        "end_position",
        "description"
      ],
      "additionalProperties": false
    },
    "SlimShotResult": {
      "type": "object",
      "description": "Minimal shot data for real-time WebSocket display (5 fields only). Full SimulationResult stored in database - use REST API GET /api/sessions/:id/deliveries for details.",
      "properties": {
        "outcome": {
          "$ref": "#/definitions/ShotOutcome"
        },
        "runs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "description": {
          "type": "string"
        },
        "end_position": {
          "$ref": "#/definitions/Position",
          "description": "For wagon wheel visualization"
        },
        "fielder_involved": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "outcome",
        "runs",
        "description",
        "end_position",
        "fielder_involved"
      ],
      "additionalProperties": false
    },
    "RadarTrackingData": {
      "type": "object",
      "properties": {
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "exit_speed": {
          "type": "number",
          "minimum": 0,
          "maximum": 200,
          "description": "km/h"
        },
        "horizontal_angle": {
          "type": "number",
          "minimum": -180,
          "maximum": 180,
          "description": "degrees from straight"
        },
        "vertical_angle": {
          "type": "number",
          "minimum": 0,
          "maximum": 90,
          "description": "degrees from horizontal"
        },
        "projected_distance": {
          "type": "number",
          "minimum": 0
        },
        "max_height": {
          "type": "number",
          "minimum": 0
        },
        "landing_x": {
          "type": "number"
        },
        "landing_y": {
          "type": "number"
        },
        "frames_captured": {
          "type": "integer",
          "minimum": 0
        },
        "detection_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "timestamp",
        "exit_speed",
        "horizontal_angle",
        "vertical_angle",
        "projected_distance",
        "max_height",
        "landing_x",
        "landing_y",
        "frames_captured",
        "detection_confidence"
      ],
      "additionalProperties": false
    },
    "ErrorPayload": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "description": "Error code from error_codes.md"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": [
            "object",
            "null"
          ]
        },
        "recoverable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "recoverable"
      ],
      "additionalProperties": false
    }
  },
  "clientToServer": {
    "description": "Messages sent from React UI to Python server",
    "set_field": {
      "type": "object",
      "properties": {
        "type": {
          "const": "set_field"
        },
        "message_id": {
          "type": "string",
          "format": "uuid"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "payload": {
          "type": "object",
          "properties": {
            "fielders": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/FielderConfig"
              },
              "minItems": 1,
              "maxItems": 11
            },
            "boundary_distance": {
              "type": "number",
              "minimum": 50,
              "maximum": 100,
              "default": 70
            }
          },
          "required": [
            "fielders"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "message_id",
        "timestamp",
        "payload"
      ],
      "additionalProperties": false
    },
    "set_difficulty": {
      "type": "object",
      "properties": {
        "type": {
          "const": "set_difficulty"
        },
        "message_id": {
          "type": "string",
          "format": "uuid"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "payload": {
          "type": "object",
          "properties": {
            "difficulty": {
              "$ref": "#/definitions/Difficulty"
            }
          },
          "required": [
            "difficulty"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "message_id",
        "timestamp",
        "payload"
      ],
      "additionalProperties": false
    },
    "select_profile": {
      "type": "object",
      "properties": {
        "type": {
          "const": "select_profile"
        },
        "message_id": {
          "type": "string",
          "format": "uuid"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "payload": {
          "type": "object",
          "properties": {
            "profile_id": {
              "type": "string"
            }
          },
          "required": [
            "profile_id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "message_id",
        "timestamp",
        "payload"
      ],
      "additionalProperties": false
    },
    "create_profile": {
      "type": "object",
      "properties": {
        "type": {
          "const": "create_profile"
        },
        "message_id": {
          "type": "string",
          "format": "uuid"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "payload": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "batting_hand": {
              "$ref": "#/definitions/BattingHand"
            }
          },
          "required": [
            "name",
            "batting_hand"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "message_id",
        "timestamp",
        "payload"
      ],
      "additionalProperties": false
    },
    "manual_input": {
      "type": "object",
      "description": "Manual ball entry when radar is not connected or for testing",
      "properties": {
        "type": {
          "const": "manual_input"
        },
        "message_id": {
          "type": "string",
          "format": "uuid"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "payload": {
          "type": "object",
          "properties": {
            "result": {
              "$ref": "#/definitions/BallResult"
            },
            "is_boundary": {
              "type": "boolean",
              "default": false
            }
          },
          "required": [
            "result"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "message_id",
        "timestamp",
        "payload"
      ],
      "additionalProperties": false
    },
    "start_session": {
      "type": "object",
      "properties": {
        "type": {
          "const": "start_session"
        },
        "message_id": {
          "type": "string",
          "format": "uuid"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "payload": {
          "type": "object",
          "properties": {
            "profile_id": {
              "type": "string"
            },
            "field_config": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/FielderConfig"
              }
            },
            "difficulty": {
              "$ref": "#/definitions/Difficulty"
            },
            "notes": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 500
            }
          },
          "required": [
            "profile_id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "message_id",
        "timestamp",
        "payload"
      ],
      "additionalProperties": false
    },
    "end_session": {
      "type": "object",
      "properties": {
        "type": {
          "const": "end_session"
        },
        "message_id": {
          "type": "string",
          "format": "uuid"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "payload": {
          "type": "object",
          "properties": {
            "session_id": {
              "type": "string"
            },
            "save_to_database": {
              "type": "boolean",
              "default": true
            }
          },
          "required": [
            "session_id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "message_id",
        "timestamp",
        "payload"
      ],
      "additionalProperties": false
    },
    "undo": {
      "type": "object",
      "properties": {
        "type": {
          "const": "undo"
        },
        "message_id": {
          "type": "string",
          "format": "uuid"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "payload": {
          "type": "object",
          "properties": {
            "session_id": {
              "type": "string"
            }
          },
          "required": [
            "session_id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "message_id",
        "timestamp",
        "payload"
      ],
      "additionalProperties": false
    },
    "update_profile": {
      "type": "object",
      "description": "Update an existing player profile (rename, change batting hand)",
      "properties": {
        "type": {
          "const": "update_profile"
        },
        "message_id": {
          "type": "string",
          "format": "uuid"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "payload": {
          "type": "object",
          "properties": {
            "profile_id": {
              "type": "string"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "batting_hand": {
              "$ref": "#/definitions/BattingHand"
            }
          },
          "required": [
            "profile_id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "message_id",
        "timestamp",
        "payload"
      ],
      "additionalProperties": false
    },
    "ping": {
      "type": "object",
      "description": "Heartbeat ping from client to keep connection alive",
      "properties": {
        "type": {
          "const": "ping"
        },
        "message_id": {
          "type": "string",
          "format": "uuid"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "type",
        "message_id",
        "timestamp"
      ],
      "additionalProperties": false
    },
    "simulate_shot": {
      "type": "object",
      "description": "Run a full shot simulation on the server engine (shot simulator UI). The optional seed makes the outcome reproducible and identical to the client's local engine fallback.",
      "properties": {
        "type": {
          "const": "simulate_shot"
        },
        "message_id": {
          "type": "string",
          "format": "uuid"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "payload": {
          "type": "object",
          "properties": {
            "exit_speed": {
              "type": "number",
              "minimum": 0,
              "maximum": 200
            },
            "horizontal_angle": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "vertical_angle": {
              "type": "number",
              "minimum": 0,
              "maximum": 90
            },
            "field_config": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/FielderConfig"
              }
            },
            "boundary_distance": {
              "type": "number",
              "default": 70
            },
            "difficulty": {
              "enum": [
                "easy",
                "medium",
                "hard"
              ]
            },
            "seed": {
              "type": "integer",
              "description": "Optional 32-bit PRNG seed (shared mulberry32 in both engines)"
            }
          },
          "required": [
            "exit_speed",
            "horizontal_angle",
            "vertical_angle",
            "field_config"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "type",
        "message_id",
        "timestamp",
        "payload"
      ],
      "additionalProperties": false
    },
    "start_recording": {
      "type": "object",
      "description": "Start raw radar capture to a crash-safe JSONL file on the Pi.",
      "properties": {
        "type": {
          "const": "start_recording"
        },
        "message_id": {
          "type": "string",
          "format": "uuid"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "payload": {
          "type": "object",
          "properties": {
            "session_type": {
              "enum": [
                "bowling",
                "batting",
                "both",
                "foil_ball",
                "racket",
                "racket_foil"
              ]
            },
            "max_duration": {
              "type": "number",
